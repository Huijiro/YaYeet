# Maintainer: Gabriel Rodrigues <huijirohankei@gmail.com>
pkgname=yayeet
pkgver=1.3.1
pkgrel=1
pkgdesc="Linux launcher for installing and running Voices of the Void through Wine or Proton"
arch=('x86_64')
url="https://github.com/Huijiro/YaYeet"
license=('MIT')
depends=(
  'glibc'
  'libglvnd'
  'libx11'
  'libxcursor'
  'libxi'
  'libxinerama'
  'libxkbcommon'
  'libxrandr'
  'libxxf86vm'
  'wayland'
)
makedepends=('go')
optdepends=(
  'wine: run Voices of the Void using Wine'
  'steam: provide installed Proton runners'
  'lutris: provide Lutris-managed runners'
)
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  'LICENSE'
)
sha256sums=(
  '6c4578cc9c8495e977cb87fc5842700d4631806383829044b7592a66ce159e56'
  '0d8aeacdf684f5108359d275356cc2bf3ab290c98a07632207d3bd8269bc63a8'
)

prepare() {
  cd "YaYeet-$pkgver"
  mkdir -p build
}

build() {
  cd "YaYeet-$pkgver"

  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"

  go build \
    -ldflags="-linkmode=external -s -w -X github.com/Huijiro/YaYeet/internal/buildinfo.Version=$pkgver -X github.com/Huijiro/YaYeet/internal/buildinfo.InstallMethod=aur" \
    -o build/yayeet ./cmd/yayeet
}

package() {
  cd "YaYeet-$pkgver"

  install -Dm755 build/yayeet "$pkgdir/usr/bin/yayeet"
  install -Dm644 packaging/yayeet.desktop \
    "$pkgdir/usr/share/applications/yayeet.desktop"
  install -Dm644 packaging/yayeet.png \
    "$pkgdir/usr/share/icons/hicolor/64x64/apps/yayeet.png"
  install -Dm644 "$srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
